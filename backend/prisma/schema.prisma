generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  // Set when the account was created via / linked to an SSO login. subject
  // is the OIDC "sub" claim, scoped per-provider so the same email across
  // two providers can't silently take over one account.
  ssoProvider  String?
  ssoSubject   String?
  name         String?
  role         Role     @default(USER)
  // Data URL (base64), same storage pattern as chat-attached images —
  // avoids needing a static file server. Kept small by the upload route
  // (downscaled + size-capped before it ever reaches the DB).
  avatarUrl    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Bumped (fire-and-forget, best-effort) on every authenticated request —
  // powers the "Last Active" column in the admin Users table. Null means
  // the user has never made an authenticated request since this field was
  // added (existing rows on upgrade), not "long ago", so the UI shows "—".
  lastActiveAt DateTime?
  // Set when the user accepted the Terms of Service during registration
  // (see AppSettings.termsRequired / termsOfService). Null for accounts
  // created before this field existed, or if terms weren't required at
  // the time they signed up.
  termsAcceptedAt DateTime?

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // ---- 2FA (TOTP) ----
  // twoFaSecret is set as soon as setup begins but twoFaEnabled stays false
  // until the user confirms a code, so an abandoned setup never locks the
  // account. backupCodes are one-time-use fallback codes, stored hashed.
  twoFaSecret      String?
  twoFaEnabled     Boolean  @default(false)
  twoFaBackupCodes String[] @default([])

  // ---- Billing (Stripe) ----
  // Only used for one-time credits purchases (Stripe Checkout, mode:
  // "payment") — the old recurring-subscription plan system has been
  // removed in favor of pay-as-you-go credits (see `credits` below).
  stripeCustomerId              String?   @unique

  // ---- Token waste tracking ----
  // Sum of prompt+completion tokens for ASSISTANT replies that were later
  // discarded — via "regenerate" (old reply thrown away for a new one) or
  // editing an earlier user message (everything after it, including the
  // reply, is dropped). Never decremented; a running lifetime counter used
  // by the admin analytics dashboard to show how many tokens were spent on
  // answers nobody ended up using.
  wastedTokens Int @default(0)

  // ---- Credits (pay-as-you-go, replaces the old subscription upsell) ----
  // 1 credit = €0.01. Spent on image/video generation (see
  // lib/mediaCost.ts for the per-model price table and lib/credits.ts for
  // the spend/refund logic), topped up via Stripe Checkout one-time
  // payments (routes/credits.ts). Admins are never charged (see
  // routes/generate.ts) so this can stay 0 for admin accounts forever.
  credits Int @default(0)

  // Set the first time the user dismisses/completes the onboarding modal.
  // Null means "never shown" — the frontend shows the onboarding modal
  // once, on first login, then never again.
  onboardingSeenAt DateTime?

  chats       Chat[]
  creditTopups CreditTopup[]
  apiKeys     ApiKey[]
  documents   Document[]
  prompts     Prompt[]
  quotaEvents QuotaEvent[]
  musicGenerations MusicGeneration[]
  mediaGenerations MediaGeneration[]
  mediaGenerationLikes MediaGenerationLike[]
  mediaElements MediaElement[]
  createdChannels Channel[]        @relation("ChannelCreator")
  channelMemberships ChannelMember[]
  channelMessages ChannelMessage[]
  notes       Note[]
  arenaVotes  ArenaVote[]
  automations Automation[]
  securityAlerts SecurityAlert[]
  memories    UserMemory[]
  ownedProjects Project[] @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  serverConnection ServerConnection?
  notifications Notification[]

  @@unique([ssoProvider, ssoSubject])
}

// A permission group. Membership is single-group-per-user (keep it simple:
// most self-hosted deployments want "default / trusted / restricted" tiers,
// not full RBAC). modelAccess is a plain string array of Ollama model names
// the group is allowed to use; an empty array means "all models" so existing
// deployments upgrading from no-groups keep working without config.
model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  modelAccess String[] @default([])
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Daily per-user token cap for this group, covering both chat generation
  // (prompt + completion tokens) and image generation (charged a flat
  // token-equivalent cost — see lib/quota.ts IMAGE_TOKEN_COST). One shared
  // budget rather than a separate per-image cap. null = defer to the
  // DEFAULT_TOKEN_QUOTA fallback in quota.ts, not "unlimited" — there is
  // no separate unlimited sentinel.
  dailyTokenQuota Int?

  users User[]
  invites Invite[]

  @@index([isDefault])
}

// An outstanding (or resolved) invitation to join the deployment. Created
// by an admin from Admin > Users > Invite user; the recipient gets an
// email with a registration link carrying `token`, which prefills and
// locks their email on the register page and — once they submit — assigns
// the role/group configured here and skips the signup-enabled gate and
// captcha (an admin-issued invite is itself the gate). acceptedAt stays
// null while pending; set once the invite is used, at which point it can
// no longer be redeemed again. revokedAt lets an admin cancel a pending
// invite without deleting the row, so "who invited whom and when" stays
// in the history.
model Invite {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  role      Role      @default(USER)
  groupId   String?
  group     Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([token])
}

// One row per generation event (a chat reply or an image), instead of one
// row per (user, day). tokens is the actual prompt+completion token count
// for a chat reply, or the flat token-equivalent cost for a generated
// image (see lib/quota.ts IMAGE_TOKEN_COST) — both draw from the same
// budget. isImage is purely informational, for the "images generated"
// counter shown in the UI; it doesn't gate anything on its own.
//
// A per-event log (rather than a per-day counter) is what lets quota.ts
// implement a rolling window (à la Claude.ai's 5-hour window) instead of a
// hard reset at midnight UTC: usage is computed by summing tokens over
// `createdAt >= now - QUOTA_WINDOW_MS`, so budget frees up gradually as
// old events age out of the window rather than all at once at a fixed
// clock time. The @@index on (userId, createdAt) keeps that sum cheap.
model QuotaEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens    Int
  isImage   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum WebhookEvent {
  USER_REGISTERED
  MESSAGE_SENT
  MESSAGE_FLAGGED
  PIPELINE_BLOCKED
  IMAGE_GENERATED
  SUBSCRIPTION_UPDATED
}

// One row per music-generation request. Created (PENDING) when the task is
// kicked off with the provider, then filled in with the resulting tracks
// once GET /music/generate/:taskId observes it complete (or marked FAILED).
// This is what backs the public library page (/music/library) — tracks
// from every user show up there grouped by genre so anyone on the
// deployment can find, play, and download what's been made. Token-quota
// enforcement itself is unrelated to this table — that's the QuotaEvent
// row already recorded via recordTokenUsage in routes/music.ts.
model MusicGeneration {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId     String              @unique
  status     MusicGenStatus      @default(PENDING)
  prompt     String
  // Free-text genre/style tag(s), comma-separated (e.g. "synthwave, upbeat,
  // 120bpm") — only set in custom mode. Used to power the library's genre
  // filter; simple-mode generations (no explicit style) just show up
  // ungrouped/under "Other".
  style      String?
  title      String?
  instrumental Boolean           @default(false)
  // [{ id, title, audioUrl, durationSeconds }] once complete — mirrors
  // lib/music.ts's MusicTrack shape so the frontend can reuse the same type.
  tracks     Json?
  error      String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

enum MusicGenStatus {
  PENDING
  COMPLETE
  FAILED
}

// Kling-style image/video generation via kie.ai's jobs API (see lib/kieGen.ts,
// routes/generate.ts). Mirrors MusicGeneration's shape/lifecycle.
model MediaGeneration {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId     String              @unique
  modality   MediaModality
  modelKey   String
  status     MusicGenStatus      @default(PENDING)
  prompt     String
  aspectRatio String?
  durationSeconds Int?
  // Persisted result URL(s) once complete — image: 1 url; video: 1 url.
  // Stored as JSON array for parity with MusicGeneration.tracks.
  resultUrls Json?
  error      String?
  // Credits actually charged for this generation (see lib/mediaCost.ts) —
  // stored per-row rather than recomputed later since the price table can
  // change over time and a past generation must keep the price it was
  // actually charged. Null for rows created before the credits system
  // existed. creditsRefunded flips true the moment a FAILED result refunds
  // this amount back to the user, so the poll endpoint never double-refunds
  // the same generation.
  creditsCharged   Int?
  creditsRefunded  Boolean @default(false)
  // Explore feed: a user can publish a completed generation so it shows up
  // in the public feed with a like count. Off by default — nothing is
  // public until the owner opts in.
  isPublic   Boolean             @default(false)
  publishedAt DateTime?
  likeCount  Int                 @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  likes      MediaGenerationLike[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([isPublic, publishedAt])
}

// One row per (user, generation) like. Existence of a row IS the like —
// this is what makes liking idempotent per account instead of the old
// plain counter anyone could increment over and over by spamming the
// button or replaying the request.
model MediaGenerationLike {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaGenerationId String
  mediaGeneration   MediaGeneration @relation(fields: [mediaGenerationId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@unique([userId, mediaGenerationId])
}

// One row per completed Stripe Checkout session that paid for a credits
// package — sessionId is unique so the webhook can never credit the same
// purchase twice, even if Stripe retries the event delivery.
model CreditTopup {
  id        String   @id @default(cuid())
  sessionId String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credits   Int
  amountCents Int
  createdAt DateTime @default(now())

  @@index([userId])
}

// Named reference images ("@dog", "@mycharacter") a user can bind into a
// kling-3.0/video prompt for consistent characters/objects across
// generations. Maps to kie.ai's kling_elements input array (see
// lib/kieGen.ts buildKlingElements + routes/generate.ts).
model MediaElement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrls   Json
  createdAt   DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}

enum MediaModality {
  IMAGE
  VIDEO
}

enum NotificationType {
  GENERATION_COMPLETE
  GENERATION_FAILED
}

// In-app notification bell (top of the app, synced with the account —
// not the browser-permission desktop popup in lib/notificationPref.ts,
// which is a separate, purely client-side feature). One row per event;
// sourceId carries the MediaGeneration.taskId so a click can deep-link
// straight to the result. readAt is null until the user opens/dismisses
// it — that's what drives the unread red-dot count.
model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  // Opaque id of whatever this notification is about (currently always a
  // MediaGeneration.taskId) — kept as a plain string rather than a
  // relation so future notification types don't need a new nullable FK
  // column each time.
  sourceId  String?
  readAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// Admin-configured outbound webhook. Fires an HMAC-signed POST for each
// subscribed event; delivery is fire-and-forget (see lib/webhooks.ts) so a
// slow or down endpoint never blocks the request that triggered it.
model Webhook {
  id        String         @id @default(cuid())
  url       String
  secret    String
  events    WebhookEvent[]
  enabled   Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  deliveries WebhookDelivery[]
}

enum WebhookDeliveryStatus {
  SUCCESS
  FAILED
}

// One row per delivery attempt (including retries), so the admin panel can
// show a per-webhook history of what fired, when, and whether it eventually
// succeeded. Written by lib/webhooks.ts, never by a route handler directly.
model WebhookDelivery {
  id           String                 @id @default(cuid())
  webhookId    String
  webhook      Webhook                @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        WebhookEvent
  status       WebhookDeliveryStatus
  statusCode   Int?
  error        String?
  attempt      Int                    @default(1)
  createdAt    DateTime               @default(now())

  @@index([webhookId, createdAt])
}

// Saved prompt preset. Personal by default; sharedWithAll surfaces it to
// every user in the Prompt Library regardless of who created it (admin-only
// to set, enforced in the route handler).
model Prompt {
  id            String   @id @default(cuid())
  title         String
  content       String   @db.Text
  description   String?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedWithAll Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  lastUsed  DateTime?
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  chats     Chat[]
}

model Chat {
  id        String   @id @default(cuid())
  title     String   @default("New chat")
  pinned    Boolean  @default(false)
  archived  Boolean  @default(false)
  model     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId  String?
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Persistent per-chat overrides. systemPrompt is prepended ahead of any
  // RAG context block; the three model params are used as defaults for
  // every /messages call unless the request body overrides them.
  // Persistent per-chat overrides. systemPrompt is prepended ahead of any
  // RAG context block; these are used as defaults for every /messages call
  // unless the request body overrides them. Mirrors every Ollama option
  // exposed in the Chat Controls panel (frontend/components/
  // ChatControlsPanel.tsx) — one column per slider, so a value the user
  // sets there survives a reload instead of silently resetting.
  systemPrompt     String?  @db.Text
  temperature      Float?
  topP             Float?
  numCtx           Int?
  minP             Float?
  topK             Int?
  frequencyPenalty Float?
  mirostat         Int?
  mirostatEta      Float?
  mirostatTau      Float?
  tfsZ             Float?
  seed             Int?
  repeatLastN      Int?
  numBatch         Int?
  numKeep          Int?
  numPredict       Int?
  useMmap          Boolean?
  useMlock         Boolean?
  streamResponse   Boolean?
  stopSequence     String?  @db.Text

  // Agent mode (own build, not a third-party product): when on, the
  // model may chain multiple tool calls in a row within one turn instead
  // of the normal "one tool call, then answer" limit — e.g. search, then
  // read a page, then write a file, without the user prompting each
  // step. Off by default; toggled per-chat from the frontend. See
  // routes/chats.ts's runAgentLoop for the bounded step loop this gates.
  agentMode Boolean @default(false)

  messages Message[]
  documents ChatDocument[]
  tools     ChatTool[]
  automations Automation[]

  // Public share link. shareId is a separate random token (not the chat's own
  // id) so links can be revoked/rotated without changing the chat's identity.
  // isPublic gates the public read-only route even if a shareId exists, so
  // "unshare" is instant without needing to also null out the token.
  shareId  String?  @unique
  isPublic Boolean  @default(false)

  @@index([userId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model Message {
  id        String      @id @default(cuid())
  chatId    String
  chat      Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String       @db.Text
  // Set only on TOOL messages: which tool produced this content, so the UI
  // can render a distinct "used <toolName>" line instead of a plain bubble.
  toolName  String?
  createdAt DateTime    @default(now())

  // Base64-encoded images attached to a USER message (vision models —
  // llama3.2-vision, qwen2.5vl, llava, ...). Empty for every other
  // message and ignored entirely by text-only models.
  images    String[]    @default([])

  // Snapshot of which chat-attached documents were "sent" alongside this
  // USER message — i.e. still in the composer's chip row the moment Send
  // was hit. Purely a UI record (so a page reload doesn't make the doc
  // reappear in the composer once it's already shown on a bubble); RAG
  // itself always uses whatever's currently in ChatDocument for the whole
  // chat, not this snapshot. Stored as
  // Array<{ id: string; filename: string; status?: string }>. Null/empty
  // for every non-USER message and for older rows from before this
  // existed.
  documents Json?

  flagged    Boolean     @default(false)
  flagReason String?

  // Thumbs up/down on an ASSISTANT message: 1 = up, -1 = down, null =
  // unrated. USER/SYSTEM/TOOL messages are never rated.
  rating Int?

  // Analytics — set only on ASSISTANT messages, straight from Ollama's
  // response (prompt_eval_count / eval_count on the final streamed chunk).
  // Null for USER/SYSTEM/TOOL messages and for older rows created before
  // this field existed — the analytics queries treat null as "unknown",
  // not zero, so historical averages aren't skewed.
  model            String?
  promptTokens     Int?
  completionTokens Int?

  // "What the AI did and thought" timeline — set only on ASSISTANT messages.
  // `reasoning` is the model's own chain-of-thought (Ollama's native
  // `thinking` field, for reasoning-capable models like deepseek-r1/qwq/
  // gpt-oss — null for models that don't emit one). `steps` is the ordered
  // list of system-side actions taken while producing this reply (RAG
  // lookup, web search, tool call, ...), stored as
  // Array<{ type: string; label: string; status: "start"|"done"|"error"; detail?: string; at: string }>.
  // Both are streamed live over SSE as they happen, then persisted here so
  // they're still visible after a page reload.
  reasoning String? @db.Text
  steps     Json?

  @@index([chatId])
  @@index([createdAt])
  @@index([model])
  @@index([rating])
}

enum PipelineStage {
  PRE  // runs on the user's message before it reaches the model
  POST // runs on the assistant's reply after generation
}

enum PipelineAction {
  BLOCK // PRE only: reject the message, nothing is sent to the model
  FLAG  // marks the message for admin review, request still proceeds
}

enum PipelineMatchType {
  KEYWORD // case-insensitive substring match, pattern is a comma-separated list
  REGEX   // pattern is a JS regex (no flags beyond i, applied automatically)
  AI      // pattern is a natural-language moderation instruction, judged by an LLM
}

// A simple moderation/hook rule. Evaluated in `order` for every PRE stage
// before a user message is persisted, and every POST stage after the
// assistant's full reply is assembled. KEYWORD/REGEX need zero extra
// services; AI rules call the same local Ollama instance everything else
// uses, at the (small) cost of one extra model call per message.
model Pipeline {
  id        String            @id @default(cuid())
  name      String
  enabled   Boolean           @default(true)
  stage     PipelineStage
  matchType PipelineMatchType
  pattern   String            @db.Text
  action    PipelineAction
  message   String            @default("This message was blocked by a moderation rule.")
  order     Int               @default(0)
  // Only used when matchType = AI: which model judges the content against
  // `pattern` (the moderation instruction). Falls back to a small default
  // model at call time if unset, so existing KEYWORD/REGEX rules are
  // unaffected.
  aiModel   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([stage, enabled])
}

enum SecurityAlertType {
  DUPLICATE_CONTENT_BURST // same/near-identical message sent across many chats in a short window
  MESSAGE_RATE_BURST      // far more messages than normal in a short window
  RAPID_SIGNUP            // many accounts created from the same pattern in a short window
}

enum SecurityAlertStatus {
  OPEN
  DISMISSED
  ACTIONED // admin took action (e.g. disabled the account)
}

// Written by the 24/7 background security scanner (lib/security-scanner.ts)
// — not by any per-message pipeline rule. Where Pipeline rules judge one
// message in isolation, these catch patterns only visible across many
// messages/users over time (spam bots, scripted signup abuse, etc.), so an
// admin has one place to see "what looks like an attack right now"
// regardless of which detector caught it.
model SecurityAlert {
  id        String              @id @default(cuid())
  type      SecurityAlertType
  status    SecurityAlertStatus @default(OPEN)
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  summary   String              @db.Text
  detail    Json?
  createdAt DateTime            @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

enum ToolType {
  BUILTIN
  HTTP
  MCP
}

// A tool the model can call mid-conversation. BUILTIN tools run in-process
// (see lib/tools.ts) and are seeded at startup — they can't be created or
// edited through the API, only enabled/disabled. HTTP tools are admin-defined
// integrations against an external API; `config` holds everything needed to
// make the call (see lib/tools.ts for the shape).
model Tool {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @db.Text
  type        ToolType
  // For BUILTIN: unused. For HTTP: { method, url, headers, bodyTemplate,
  // parameters: [{ name, type, description, required }] } as JSON.
  config      Json     @default("{}")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chats ChatTool[]
}

// Join table: which tools are enabled for a given chat. The model only sees
// (and can call) tools attached here, never the full tool catalog.
model ChatTool {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([chatId, toolId])
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

// A document the user has uploaded (their personal library). Attach it
// to one or more chats via ChatDocument to bring it into RAG context.
model Document {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  sizeBytes Int
  status    DocumentStatus @default(PENDING)
  error     String?
  createdAt DateTime       @default(now())

  chunks    DocumentChunk[]
  chatLinks ChatDocument[]

  @@index([userId])
}

// Chunked, embedded slice of a document. `embedding` is a pgvector column —
// Prisma can't type it natively, so it's marked Unsupported and every
// read/write to it goes through raw SQL (see lib/rag.ts).
model DocumentChunk {
  id         String                 @id @default(cuid())
  documentId String
  document   Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String                 @db.Text
  embedding  Unsupported("vector")?
  createdAt  DateTime               @default(now())

  @@index([documentId])
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

// App-level event log, queried by the admin panel. Deliberately a plain DB
// table rather than a Loki/ELK integration — zero extra services, and
// "tail the last N events, filter by level/source" covers what a self-hosted
// admin actually needs day to day. Prune old rows with a cron/cleanup job if
// volume gets large; there's no automatic retention here.
model Log {
  id        String   @id @default(cuid())
  level     LogLevel @default(INFO)
  source    String   // e.g. "auth", "sso", "document", "tool", "pipeline"
  message   String   @db.Text
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source])
  @@index([level])
}

// Join table: which documents are attached to which chat's RAG context.
model ChatDocument {
  id         String   @id @default(cuid())
  chatId     String
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([chatId, documentId])
}


// A Filter is admin-submitted Python that hooks into the chat pipeline —
// OpenWebUI calls this "Functions". Unlike Pipeline (keyword/regex only),
// a Filter can run arbitrary logic: rewrite the outgoing prompt, call an
// external API, redact/annotate the model's reply, etc. Code never runs
// in the backend process — see lib/functions-sandbox.ts, which ships each
// run to the sandbox-runner service as an ephemeral, network-less
// container. `modelNames` empty = applies to every model, same convention
// as Group.modelAccess. `priority` orders multiple enabled filters low to
// high, same idea as Pipeline.order.
model Filter {
  id         String   @id @default(cuid())
  name       String
  enabled    Boolean  @default(true)
  code       String   @db.Text
  modelNames String[] @default([])
  priority   Int      @default(0)
  timeoutMs  Int      @default(5000)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lastError String?
  lastRunAt DateTime?

  @@index([enabled, priority])
}

// A Pipe is admin-submitted Python that acts as a custom model provider —
// OpenWebUI's other Functions type. Instead of hooking an existing Ollama
// call like Filter does, a Pipe REPLACES the model call entirely: its
// `pipe(body, user)` method returns the full response text itself, so it
// can call an external API, chain multiple Ollama calls, or implement
// custom routing logic. Registered pipes show up in the model picker
// alongside real Ollama models, prefixed so they're never confused with
// one (see routes/models.ts). Same sandbox, same isolation as Filter.
model Pipe {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // model-picker id, e.g. "pipe:my-router"
  enabled     Boolean  @default(true)
  code        String   @db.Text
  description String?
  timeoutMs   Int      @default(30000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lastError String?
  lastRunAt DateTime?

  @@index([enabled])
}

// An Action is admin-submitted Python that backs a custom button shown in
// the chat toolbar next to a message (OpenWebUI's third Functions type).
// `action(body, user)` runs on click and returns a dict the frontend
// renders as a toast/side panel — it does not stream and is not chained
// with other actions.
model Action {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  enabled    Boolean  @default(true)
  code       String   @db.Text
  icon       String   @default("Zap")
  timeoutMs  Int      @default(10000)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lastError String?
  lastRunAt DateTime?

  @@index([enabled])
}

// ---- MCP tool servers ----
model McpServer {
  id        String    @id @default(cuid())
  name      String    @unique
  url       String
  transport String    @default("http") // "http" | "sse"
  headers   Json      @default("{}")
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  lastSyncAt    DateTime?
  lastSyncError String?
}

// ---- Channels (Slack-style multi-user rooms) ----
model Channel {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isPrivate   Boolean  @default(false)
  createdById String
  createdBy   User     @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  ChannelMember[]
  messages ChannelMessage[]
}

model ChannelMember {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([channelId, userId])
}

model ChannelMessage {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  isBot     Boolean  @default(false)
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([channelId, createdAt])
}

// ---- Notes workspace ----
model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Untitled note")
  content   String   @db.Text @default("")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

// A recurring background agent: "run this prompt against this model every
// N minutes, 24/7, with no user present to click send". Each run appends a
// USER + ASSISTANT message pair to the linked Chat (created automatically
// on first run if chatId is still null) so results show up as an ordinary,
// scrollable conversation — nothing new to build on the history side.
model Automation {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  prompt        String   @db.Text
  model         String
  // How often this runs, in minutes (e.g. 60 = hourly). Deliberately a
  // plain interval rather than full cron syntax — the "usual activity"
  // asked for is recurring monitoring/report jobs, not calendar-precise
  // scheduling, and an interval needs no parser or timezone handling.
  intervalMinutes Int
  enabled       Boolean  @default(true)

  // The chat this automation's runs are appended to as messages. Null
  // until the first run creates one (named after the automation).
  chatId String?
  chat   Chat?   @relation(fields: [chatId], references: [id], onDelete: SetNull)

  lastRunAt   DateTime?
  nextRunAt   DateTime  @default(now())
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs AutomationRun[]

  @@index([userId])
  @@index([enabled, nextRunAt])
}

enum AutomationRunStatus {
  SUCCESS
  FAILED
}

// One row per execution — lets the UI show a run history (and error
// detail) separately from the chat transcript, which only holds the
// successful output.
model AutomationRun {
  id           String              @id @default(cuid())
  automationId String
  automation   Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  status       AutomationRunStatus
  output       String?             @db.Text
  error        String?
  startedAt    DateTime            @default(now())
  finishedAt   DateTime?

  @@index([automationId, startedAt])
}

// ---- Global instance settings (admin Settings > General) ----
// Deliberately a single row (id fixed to "singleton") rather than a
// key/value table — the toggle set is small, known, and read on nearly
// every page load, so one row is simpler than a KV table with N lookups.
// Add a field here whenever a new toggle/text setting is needed; existing
// deployments upgrade for free since every field has a default.
model AppSettings {
  id                     String   @id @default("singleton")
  communitySharingEnabled Boolean @default(true)
  messageRatingEnabled   Boolean  @default(true)
  foldersEnabled         Boolean  @default(true)
  memoriesEnabled        Boolean  @default(true)
  memorySystemContextEnabled Boolean @default(true)
  notesEnabled           Boolean  @default(true)
  channelsEnabled        Boolean  @default(true)
  calendarEnabled        Boolean  @default(false)
  automationsEnabled     Boolean  @default(true)
  userWebhooksEnabled    Boolean  @default(false)
  userStatusEnabled      Boolean  @default(false)

  // ---- Sidebar / navigation visibility (Admin > Settings > General) ----
  // Lets an admin hide entire features from the app without disabling the
  // underlying functionality — the routes still work if visited directly,
  // this just controls whether the nav link is shown. Defaults to true so
  // existing deployments look unchanged until an admin opts out.
  playgroundEnabled      Boolean  @default(true)
  studioEnabled          Boolean  @default(true)
  arenaEnabled           Boolean  @default(true)

  // ---- Upgrade button (Admin > Settings > General) ----
  // Hides the "Upgrade" button in the chat header, independent of whether
  // Stripe is actually configured — useful for deployments that don't want
  // to surface billing at all.
  upgradeButtonEnabled   Boolean  @default(true)

  // ---- CAPTCHA (Admin > Settings > General) ----
  // Self-hosted animated slide-puzzle challenge shown on Login and
  // Register when enabled — no third-party service or API key needed.
  // Defaults to true so a fresh deployment is protected out of the box;
  // an admin can turn it off from Admin > Settings > General.
  captchaEnabled         Boolean  @default(true)

  responseWatermark      String?
  webuiUrl               String?
  banners                Json     @default("[]")

  // ---- Terms of Service (Admin > Settings > General) ----
  // Shown as a required "accept before continuing" step on the
  // registration page, in the style of Claude's onboarding. Content is
  // plain text/markdown, always rendered in English. termsRequired
  // defaults to false so existing deployments aren't suddenly blocked
  // from signing up until an admin opts in and fills in real content.
  termsRequired          Boolean  @default(false)
  termsOfService         String?  @db.Text

  // ---- Stripe / billing ----
  // Optional DB-backed override of the STRIPE_* env vars, set from
  // Admin > Settings > Billing. Kept nullable so an operator can keep
  // using env vars alone (billing.ts falls back to process.env for any
  // field left null here). Only used for one-time credits purchases —
  // the old recurring-subscription plan system has been removed.
  stripeSecretKey        String?
  stripePublishableKey   String?
  stripeWebhookSecret    String?

  // ---- Music generation (Suno-compatible provider) ----
  // Optional DB-backed override of the MUSIC_GEN_* env vars, set from
  // Admin > Settings > Music. Same "DB wins, falls back to env" pattern
  // as the Stripe fields above — see lib/music.ts.
  musicGenEnabled        Boolean  @default(false)
  musicGenUrl            String?
  musicGenApiKey         String?
  musicGenModel          String?
  musicGenCallbackUrl    String?

  // ---- Image/Video generation (kie.ai jobs API — Kling-style Generate page) ----
  // Same "DB wins, falls back to env" pattern as musicGen* above — see
  // lib/kieGen.ts. Separate from the existing IMAGE_GEN_* provider (which
  // powers inline chat image generation) because kie.ai's jobs API is a
  // different wire format (createTask / recordInfo, async polling) that
  // fronts many models (Nano Banana, GPT Image, Seedance, ...) by id.
  kieGenEnabled          Boolean  @default(false)
  kieGenUrl              String?
  kieGenApiKey           String?

  // ---- SSO / OIDC login (Microsoft, Google, Okta, Keycloak, ...) ----
  // Optional DB-backed override of the OIDC_* env vars, set from
  // Admin > Settings > Login. Same "DB wins, falls back to env" pattern
  // as the Stripe/music fields above — see lib/oidc.ts. ssoEnabled is
  // nullable on purpose: null means "no explicit admin choice yet", so
  // an existing deployment configured purely via OIDC_* env vars keeps
  // working after upgrading (falls back to "creds present = enabled")
  // until an admin actually flips the toggle in the panel.
  //
  // This is the ORIGINAL single-provider config, kept exactly as-is for
  // backward compatibility — deployments that already had e.g. Microsoft
  // configured here, with users already linked via
  // User.ssoProvider == this ssoProviderName string, keep working
  // unchanged. Additional providers (so more than one "Continue with…"
  // button at once — Microsoft AND Google, say) go in the new
  // SsoProvider table below instead; lib/oidc.ts merges this legacy
  // config (if enabled) together with all enabled SsoProvider rows into
  // one list. New setups can leave all of these null and use only the
  // SsoProvider table.
  ssoEnabled             Boolean?
  ssoProviderName        String? // button label, e.g. "Microsoft", "Google"
  ssoIssuerUrl           String? // e.g. https://login.microsoftonline.com/<tenant>/v2.0
  ssoClientId            String?
  ssoClientSecret        String?
  ssoScopes              String? // defaults to "openid email profile" if unset
  ssoRedirectUri         String? // defaults to <origin>/api/auth/sso/callback if unset

  // ---- Image generation (OpenAI-images-API-compatible) ----
  // Same nullable-enabled pattern as ssoEnabled — see lib/images.ts.
  imageGenEnabled        Boolean?
  // "custom" (default, any OpenAI-images-compatible URL — including our
  // own sd-wrapper), "selfhosted" (same wire format, just a friendlier
  // admin label + prefilled URL), "openai" (api.openai.com DALL-E),
  // "stability" (Stability AI's REST API, different request/response
  // shape, handled separately in lib/images.ts)
  imageGenProvider       String?  @default("custom")
  imageGenUrl            String?
  imageGenApiKey         String?
  stabilityApiKey        String?

  // ---- Web search (SearXNG-compatible) ----
  // Optional DB-backed override of the SEARXNG_URL env var, set from
  // Admin > Settings > Web search. Same nullable-enabled pattern as
  // imageGenEnabled/ssoEnabled — see lib/websearch.ts. null means "no
  // explicit admin choice yet", so an existing deployment that only ever
  // set SEARXNG_URL keeps working (falls back to "URL configured =
  // enabled") until an admin actually flips the toggle in the panel.
  webSearchEnabled       Boolean?
  // "searxng" is the only supported provider today — kept as a field
  // (rather than hardcoding) so a future provider (Brave Search API,
  // SerpAPI, ...) can be added without a migration.
  webSearchProvider      String?  @default("searxng")
  webSearchUrl           String?
  webSearchApiKey        String?

  // ---- Internet access (browse_web builtin tool) ----
  // Gates the "browse_web" builtin tool (see lib/tools.ts) — when off, the
  // tool is hidden from Admin > Functions and refuses to run even if a
  // chat somehow still has it attached. Off by default: unlike web search
  // (which only queries a bundled, self-hosted SearXNG instance), this lets
  // the model fetch arbitrary public URLs, so it's opt-in. null means "no
  // explicit admin choice yet" (same nullable pattern as the other
  // features above) and is treated as off.
  internetAccessEnabled  Boolean?

  // ---- Voice (speech-to-text / text-to-speech) ----
  // Optional DB-backed override of voice features, set from Admin >
  // Settings > Voice. Same nullable-enabled pattern as imageGenEnabled /
  // webSearchEnabled — see lib/voice.ts. null means "no explicit admin
  // choice yet", so an existing deployment with WHISPER_URL/PIPER_URL
  // configured keeps working (falls back to "service reachable = enabled")
  // until an admin actually flips the toggle in the panel. sttEnabled
  // controls the mic / "speak your message" input; ttsEnabled controls
  // the "Read aloud" button on assistant replies — they can be toggled
  // independently.
  voiceSttEnabled        Boolean?
  voiceTtsEnabled        Boolean?
  // Which TTS engine to speak with. "piper" (default, bundled, fully
  // local, robotic-but-fast), "coqui" (bundled XTTS-v2 wrapper, local,
  // much more natural, GPU recommended), "kokoro" (bundled Kokoro-TTS
  // wrapper, local, good natural/speed tradeoff on CPU), "elevenlabs"
  // (cloud API, the most human-sounding option, needs voiceTtsApiKey).
  // See lib/voice.ts for how each is dispatched.
  voiceTtsProvider       String?  @default("piper")
  // Piper voice model / Kokoro voice / ElevenLabs voice_id — meaning
  // depends on voiceTtsProvider. Blank = provider's own default.
  voiceTtsVoice          String?
  // Self-hosted providers only (piper/coqui/kokoro): override the
  // service URL, e.g. if it's not running under its default compose
  // service name. Blank = use PIPER_URL/COQUI_URL/KOKORO_URL env var.
  voiceTtsUrl            String?
  // Cloud providers only (elevenlabs today): API key. Blank = use the
  // ELEVENLABS_API_KEY env var. Masked in the admin UI after saving.
  voiceTtsApiKey         String?

  // ---- Usage limits / quota (Admin > Settings > Usage limits) ----
  // Optional DB-backed override of the QUOTA_* env vars (see lib/quota.ts),
  // same "DB wins, falls back to env" pattern as the sections above.
  // defaultTokenQuota mirrors DEFAULT_TOKEN_QUOTA, quotaWindowHours mirrors
  // QUOTA_WINDOW_HOURS. Both nullable: null means "no explicit admin
  // choice yet", fall back to the env var / hardcoded default.
  defaultTokenQuota      Int?
  quotaWindowHours       Int?

  // ---- "You reached the limit" popup copy (Admin > Settings > Usage
  // limits) ----
  // Lets an admin fully customize the text shown to regular users when
  // they hit their token quota. Always stored/shown in English (see
  // routes/billing.ts's public /billing/config endpoint, which returns
  // these alongside the reset time so the frontend can build the final
  // message). Null falls back to the built-in English defaults.
  limitPopupTitle        String?
  limitPopupMessage      String?
  limitPopupButtonText   String?

  // ---- Upload size limits (Admin > Settings > Uploads) ----
  // Optional DB-backed override of the hardcoded per-endpoint file size
  // caps, same "DB wins, falls back to hardcoded default" pattern as the
  // sections above — see lib/uploads.ts. Values are in MB; null means "no
  // explicit admin choice yet", fall back to the built-in default (20MB
  // documents, 25MB voice, 2MB avatar) so existing deployments are
  // unaffected until an admin sets one.
  documentMaxUploadMb    Int?
  voiceMaxUploadMb       Int?
  avatarMaxUploadMb      Int?

  // ---- Document uploads on/off (Admin > Settings > Uploads) ----
  // Kill switch for a user's document library uploads (POST /documents),
  // independent of the size limit above — lets an admin shut off uploads
  // entirely (e.g. during a storage incident) without changing the MB
  // limit. Defaults to true so existing deployments are unaffected.
  documentUploadEnabled  Boolean  @default(true)

  // ---- Image (vision) attachments on/off (Admin > Settings > Uploads) ----
  // Kill switch for the "Attach image" affordance in chat (images sent
  // inline as base64 on a message for vision models) — separate pipeline
  // from document uploads above, so it needs its own toggle. Defaults to
  // true so existing deployments are unaffected.
  imageUploadEnabled     Boolean  @default(true)
  toolsMenuEnabled       Boolean  @default(true)
  // Kill switches for the "Use camera" and "Share screen" affordances in
  // the composer's "+" menu (Admin > Settings > Uploads). Default true so
  // existing deployments are unaffected.
  cameraCaptureEnabled   Boolean  @default(true)
  screenShareEnabled     Boolean  @default(true)
  // Hides the "Controls" (Chat Controls) button in the composer for all
  // non-admin users (Admin > Settings > Uploads). Admins still see and can
  // use it regardless of this setting — it only affects other users, and
  // any per-chat controls already set keep applying either way.
  chatControlsButtonEnabled Boolean @default(true)
  // Hides the "API keys" tab in Settings for all non-admin users (Admin >
  // Settings > Uploads). Admins still see and can use it regardless of
  // this setting. Existing keys keep working either way — this only hides
  // the tab, it doesn't revoke anything.
  apiKeysTabEnabled      Boolean  @default(true)
  // Hides the animated logo shown above the "Good morning/afternoon/
  // evening" greeting on the empty chat screen (Admin > Settings >
  // Uploads). Purely cosmetic — doesn't affect anything else that uses
  // the logo (browser tab icon, sidebar, etc).
  greetingLogoEnabled    Boolean  @default(true)
  // Hides the little AI face-avatar toggle button next to the model
  // selector in the composer (Admin > Settings > Uploads). The avatar
  // feature itself (showAvatar) still works if a user already turned it
  // on before this was disabled — this only hides the toggle button.
  aiFaceAvatarEnabled    Boolean  @default(true)
  // Hides the "Music" nav entry in the ai.visiyon.com chat UI only.
  // Deliberately separate from musicGenEnabled above: that flag also
  // gates the actual generation endpoints (music.ts + the public
  // community-ai.ts routes music.visiyon.com relies on) — this one
  // does not, so the API keeps working while the UI is hidden.
  musicNavHidden         Boolean  @default(false)

  // ---- "Want to be notified?" banner (Admin > Settings > Notifications) ----
  // Kill switch for the in-chat prompt that offers to turn on desktop
  // notifications (see components/NotifyBanner.tsx). The notification
  // feature itself is always client-side (browser Notification API, see
  // lib/notificationPref.ts) — this flag only controls whether the app
  // proactively asks. Defaults to true so existing deployments keep
  // showing it until an admin opts out.
  notifyBannerEnabled    Boolean  @default(true)

  updatedAt              DateTime @updatedAt
}

// ---- Model Arena (A/B comparison + ELO leaderboard) ----
model ArenaVote {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt     String   @db.Text
  modelA     String
  modelB     String
  responseA  String   @db.Text
  responseB  String   @db.Text
  winner     ArenaWinner
  ratingAAfter Int
  ratingBAfter Int
  createdAt  DateTime @default(now())

  @@index([modelA])
  @@index([modelB])
  @@index([createdAt])
}

enum ArenaWinner {
  A
  B
  TIE
  BOTH_BAD
}

model ArenaRating {
  modelName String   @id
  rating    Int      @default(1500)
  votes     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ---- Admin display-name overrides for models ----
// Ollama model tags (e.g. "glm4:9b", "llama3.1:70b-instruct-q4_K_M") are
// accurate but not friendly for end users. This lets an admin attach a
// human-readable label (and optionally hide a model from the picker)
// without touching Ollama itself. `name` is the raw model identifier as
// returned by /models (Ollama tag, or "pipe:<slug>" for Pipes) — looked
// up as a plain map in routes/models.ts and merged into the response.
// Absence of a row means "use the raw name", so nothing needs seeding.
model ModelSetting {
  name        String   @id
  displayName String?
  hidden      Boolean  @default(false)

  // ---- Per-model defaults, editable via the admin "Model Params" modal ----
  // systemPrompt: prepended to every new chat on this model (falls back
  // behind the chat's own systemPrompt, which wins if the user/Prompt
  // Library set one — see routes/chats.ts).
  systemPrompt String? @db.Text
  // params: generation options (temperature, top_p, num_ctx, seed,
  // stop, max_tokens, ...). Free-form JSON so new Ollama options don't
  // need a migration — see routes/chats.ts for the keys actually read.
  params          Json?
  // defaultFeatures: which toggles (webSearch, imageGeneration,
  // codeInterpreter, ...) are ON by default for a brand-new chat on
  // this model. Merged into GET /models by routes/models.ts.
  defaultFeatures Json?
  // defaultToolIds: Tool.id[] — built-in/HTTP tools auto-attached to every
  // brand-new chat on this model (in addition to always-on BUILTIN tools,
  // see routes/chats.ts POST /chats). Admin-picked via the modal's Tools tab.
  defaultToolIds  Json?

  updatedAt   DateTime @updatedAt
}

// ---- External AI providers (open-source "bring your own API key") ----
// Lets an admin plug in OpenAI, Anthropic/Claude, or any OpenAI-compatible
// endpoint (Groq, Mistral, OpenRouter, Azure OpenAI, together.ai, a local
// vLLM/LM Studio server, ...) alongside the built-in Ollama models. Models
// exposed by an enabled provider show up in GET /models prefixed
// `provider:<id>:<model>` (see routes/models.ts) and are routed to the
// right SDK/HTTP client in lib/providers.ts (see routes/chats.ts).
model AiProvider {
  id      String @id @default(cuid())
  name    String @unique
  // "openai" | "anthropic" | "openai_compatible" — see lib/providers.ts.
  type    String
  // Only required for "openai_compatible" (or to override the default
  // OpenAI/Anthropic endpoint, e.g. Azure OpenAI, a self-hosted gateway).
  baseUrl String?
  // Stored encrypted at rest (AES-256-GCM, see lib/crypto.ts) — never
  // returned as-is by the API, only as a masked "sk-...ab12" preview.
  apiKeyEncrypted String @db.Text
  // Which model names this provider offers (e.g. ["gpt-4o", "gpt-4o-mini"]).
  // Editable by hand, or refreshed via POST /admin/providers/:id/test which
  // calls the provider's own /models endpoint where one exists.
  models  String[] @default([])
  enabled Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastTestedAt    DateTime?
  lastTestError   String?

  metaModelCandidates MetaModelCandidate[]
}

// ---- Additional SSO/OIDC providers (Microsoft AND Google AND ..., all
// at once) ----
// One row per extra "Continue with…" button on the login page, alongside
// (not replacing) the legacy single-provider config on AppSettings above.
// Deliberately mirrors AiProvider's shape (encrypted-secret-at-rest +
// masked-preview pattern) since it's the same kind of admin-managed
// external-credential record.
model SsoProvider {
  id String @id @default(cuid())

  // Button label, e.g. "Microsoft", "Google", "Okta" — also drives which
  // brand icon the login page shows (case-insensitively matched against
  // "microsoft"/"azure" and "google"; anything else gets a generic
  // button). Unique so two rows can't collide on the same button text.
  providerName String @unique

  issuerUrl String // e.g. https://accounts.google.com — must serve /.well-known/openid-configuration
  clientId  String

  // Stored encrypted at rest (AES-256-GCM, see lib/crypto.ts) — never
  // returned as-is by the API, only as a masked "••••ab12" preview.
  clientSecretEncrypted String @db.Text

  scopes      String? // defaults to "openid email profile" if unset
  redirectUri String? // defaults to <origin>/api/auth/sso/callback if unset

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- Meta-models ("Jean") ----
// A meta-model bundles several real candidates (a local Ollama model, an
// external provider model, ...) behind one name. Shows up in GET /models
// as "meta:<slug>" (see routes/models.ts) and is routed by lib/meta-model.ts:
// candidates race each other for the first token, and if a candidate is
// slow, unreachable, or errors, the next one takes over — invisibly, from
// the client's point of view it's just one model answering.
model MetaModel {
  id          String  @id @default(cuid())
  slug        String  @unique
  displayName String
  description String?
  enabled     Boolean @default(true)

  // How long (ms) the race waits for a first token from the currently
  // leading candidate(s) before also firing the next one — 0 means "start
  // immediately together". Keeps a normally-fast primary from always
  // paying the cost of a parallel call to a paid API when it isn't needed,
  // while still guaranteeing every candidate is in the race well before a
  // person would notice a stall.
  hedgeDelayMs Int @default(800)

  candidates MetaModelCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MetaModelCandidate {
  id          String    @id @default(cuid())
  metaModelId String
  metaModel   MetaModel @relation(fields: [metaModelId], references: [id], onDelete: Cascade)

  // Race/failover order — 0 joins immediately, 1 joins after one
  // hedgeDelayMs, 2 after two, etc. (see MetaModel.hedgeDelayMs).
  order   Int
  enabled Boolean @default(true)

  // "ollama" -> ollamaModel is a plain Ollama tag run through lib/ollama.ts
  // (i.e. your own GPU(s)). "provider" -> providerId + providerModel are
  // run through lib/providers.ts (NVIDIA API, OpenAI, Anthropic, any
  // OpenAI-compatible endpoint).
  kind          String
  ollamaModel   String?
  providerId    String?
  provider      AiProvider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerModel String?

  @@index([metaModelId])
}

// ---- AI memory ----
// One row per remembered fact about a user (name, preferences, ongoing
// projects, recurring context) — same idea as Claude's memory files, kept
// deliberately simple as flat text rows rather than a folder tree. Gated
// by two existing (previously unused) toggles on AppSettings:
//   memoriesEnabled            — master switch: capture/store facts at all
//   memorySystemContextEnabled — inject stored facts into the system
//                                prompt of new chat turns
// See lib/memory.ts for extraction + injection, and
// routes/admin.ts's /admin/users/:userId/memories for the admin-managed
// CRUD (Admin > Users > a user > Memory).
model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Short, durable fact in plain text, e.g. "Prefers concise answers" or
  // "Working on a Next.js migration at work". No categorization beyond
  // this — kept simple like a flat list of sticky notes.
  content   String   @db.Text
  // "user" = extracted from something the user said; "admin" = typed
  // directly into the admin panel. Both are treated identically when
  // building the system-prompt context block.
  source    String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---- Server connection (AI file access over SSH/SFTP on the user's own
// server). One per user. Credentials are stored encrypted (see
// lib/crypto.ts) — never returned to the client in plaintext. `baseDir`
// is an optional sandbox root: when set, every read/write/list is
// resolved relative to it and path traversal outside it is rejected. ----
model ServerConnection {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  host          String
  port          Int       @default(22)
  username      String
  // Exactly one of these is set, chosen by `authType`.
  authType      String    // "password" | "privateKey"
  passwordEnc   String?   @db.Text
  privateKeyEnc String?   @db.Text
  passphraseEnc String?   @db.Text
  baseDir       String?
  lastTestedAt  DateTime?
  lastTestOk    Boolean?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ---- Studio (in-browser code editor -> subdomain hosting) ----
// One static-site project per user (see routes/studio.ts). `files` is the
// draft currently open in the editor; `publishedFiles` is a snapshot of
// whatever was last published — kept separate so editing after a publish
// doesn't change the live site until the user explicitly publishes again.
// The actual on-disk copy nginx serves from is written by lib/sites.ts
// whenever publishedFiles changes; this row is the source of truth it's
// derived from (so a lost/corrupted disk copy can always be re-published
// from here).
model Project {
  id             String    @id @default(cuid())
  // The creator/owner. A user may own more than one project (one default
  // "own" project plus any extra ones), and can also collaborate on
  // projects owned by others via ProjectMember below.
  userId         String
  user           User      @relation("ProjectOwner", fields: [userId], references: [id], onDelete: Cascade)
  name           String    @default("My site")
  // Record<relativePath, content> — e.g. { "index.html": "...", "css/style.css": "..." }.
  // Static text files only (HTML/CSS/JS); no binary assets, no build step.
  files          Json      @default("{}")
  // Reserved, lowercase, DNS-label-safe subdomain, e.g. "janspizza" ->
  // janspizza.visiyon.com. Null until the user picks one (first publish
  // requires it). Unique across all users.
  subdomain      String?   @unique
  // Snapshot of `files` as of the last successful publish, or null if
  // never published. Distinct from `files` so draft edits don't affect
  // the live site until "Publish" is clicked again.
  publishedFiles Json?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members        ProjectMember[]

  @@index([userId])
}

// A collaborator invited onto someone else's project. The owner (see
// Project.userId) always has full access implicitly and doesn't get a
// row here; this table only holds people who were invited in. Invited by
// email — if the address matches a registered user they get instant
// access, otherwise the row is kept with userId null until someone with
// that email signs up (see routes/studio.ts "claimPendingProjectInvites").
enum ProjectRole {
  EDITOR
  VIEWER
}

model ProjectMember {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  role        ProjectRole @default(EDITOR)
  invitedById String
  createdAt   DateTime    @default(now())

  @@unique([projectId, email])
  @@index([userId])
}

// ---- Model training (LoRA fine-tuning on admin-uploaded datasets) ----
// Lets an admin upload a JSONL dataset and fine-tune one of the
// already-installed Ollama models on it, without leaving the admin panel.
// Ollama itself only serves quantized GGUF weights, which can't be
// trained directly — TrainingJob.baseModelTag is the Ollama tag the admin
// picked in the UI, and lib/training.ts resolves it to the matching
// full-precision Hugging Face repo (MODEL_CATALOG[].hfRepo) to actually
// train against. The run happens out-of-process (lib/training.ts spawns
// training/train_lora.py); this row is the queue entry + live status the
// admin panel polls, and training/train_lora.py's own stdout is streamed
// into `log` as it runs.
enum TrainingDatasetStatus {
  PENDING
  VALIDATING
  READY
  FAILED
}

// An uploaded fine-tuning dataset: one JSON object per line, each either
// {"prompt": "...", "completion": "..."} or {"messages": [...]} (same
// shape as OpenAI/Ollama chat fine-tuning files). Validated (line count,
// JSON-parseable, required keys) right after upload — see
// lib/training.ts's validateDataset — so a bad file fails fast instead of
// hours into a training run.
model TrainingDataset {
  id          String                @id @default(cuid())
  name        String
  filename    String
  sizeBytes   Int
  // Absolute path on the backend's local disk (see lib/training.ts
  // TRAINING_DATA_DIR) — datasets are usually too large/numerous to store
  // as a DB blob the way Document does for small chat images.
  path        String
  status      TrainingDatasetStatus @default(PENDING)
  exampleCount Int?
  error       String?
  createdById String
  createdAt   DateTime              @default(now())

  jobs TrainingJob[]

  @@index([status])
}

enum TrainingJobStatus {
  QUEUED
  PREPARING   // resolving base model / downloading HF weights if not cached
  TRAINING
  CONVERTING  // merging LoRA + converting to GGUF
  REGISTERING // `ollama create` of the resulting model
  COMPLETE
  FAILED
  CANCELLED
}

// One fine-tuning run. `resultModelTag` is set once REGISTERING succeeds —
// that's the tag that shows up in the normal Ollama model list/picker
// alongside every pulled model, so end users never need to know it came
// from a training job.
model TrainingJob {
  id            String            @id @default(cuid())
  name          String
  baseModelTag  String            // Ollama tag the admin picked, e.g. "llama3.2:3b"
  // Hugging Face repo actually trained against, resolved from
  // MODEL_CATALOG[].hfRepo at job-creation time (kept here too so the
  // job's record is self-contained even if the catalog entry later changes).
  baseModelHfRepo String
  datasetId     String
  dataset       TrainingDataset   @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  // ---- Hyperparameters (admin-configurable, sane defaults in the UI) ----
  epochs        Int               @default(3)
  learningRate  Float             @default(0.0002)
  loraR         Int               @default(16)
  loraAlpha     Int               @default(32)

  status        TrainingJobStatus @default(QUEUED)
  // Rolling plain-text log tail from train_lora.py's stdout/stderr,
  // appended to as the job runs — polled by the admin panel, not
  // streamed over a websocket, to keep this simple.
  log           String            @db.Text @default("")
  progressPercent Int             @default(0)
  error         String?

  // Set once RESULT is registered in Ollama — the tag other routes/UI use.
  resultModelTag String?

  createdById   String
  createdAt     DateTime          @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  @@index([status])
  @@index([createdAt])
}
